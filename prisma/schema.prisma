generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  createdAt       DateTime       @default(now())
  createdBy       String?
  firstLogin      Boolean        @default(true)
  fullName        String
  isActive        Boolean        @default(true)
  password        String
  role            Role           @default(TECHNICIAN)
  updatedAt       DateTime       @updatedAt
  updatedBy       String?
  assignedRepairs RepairTicket[]
}

model Customer {
  id            String         @id @default(uuid())
  name          String
  phone         String?        @unique
  email         String?
  address       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  createdBy     String?
  updatedBy     String?
  deletedAt     DateTime?
  repairTickets RepairTicket[]
}

model RepairTicket {
  id                     String                @id @default(uuid())
  ticketNumber           String                @unique
  customerId             String
  deviceBrand            String
  deviceModel            String
  serialNumberImei       String?
  reportedProblem        String
  technicianNotes        String?
  estimatedCost          Float
  depositAmount          Float
  status                 RepairStatus          @default(RECEIVED)
  dateReceived           DateTime              @default(now())
  expectedCompletionDate DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  createdBy              String?
  updatedBy              String?
  deletedAt              DateTime?
  deviceType             DeviceType
visibility              RepairVisibility    @default(NORMAL)
assignedTechnicianId   String?
  media                  Media[]
  payments               Payment[]
  repairParts            RepairPart[]
  statusHistory          RepairStatusHistory[]
  assignedTechnician     User?                 @relation(fields: [assignedTechnicianId], references: [id])
  customer               Customer              @relation(fields: [customerId], references: [id])
}

model Media {
  id           String       @id @default(uuid())
  repairId     String
  fileUrl      String
  fileType     MediaType
  uploadedBy   String?
  createdAt    DateTime     @default(now())
  repairTicket RepairTicket @relation(fields: [repairId], references: [id])
}

model RepairStatusHistory {
  id           String       @id @default(uuid())
  repairId     String
  status       RepairStatus
  notes        String?
  changedBy    String?
  changedAt    DateTime     @default(now())
  repairTicket RepairTicket @relation(fields: [repairId], references: [id])
}

model SparePart {
  id                String       @id @default(uuid())
  name              String
  sku               String       @unique
  category          String
  quantityAvailable Int
  lowStockThreshold Int          @default(5)
  unitCost          Float
  unitPrice         Float
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?
  repairParts       RepairPart[]
}

model RepairPart {
  id             String       @id @default(uuid())
  repairId       String
  partId         String
  quantityUsed   Int
  unitPriceAtUse Float
  createdAt      DateTime     @default(now())
  sparePart      SparePart    @relation(fields: [partId], references: [id])
  repairTicket   RepairTicket @relation(fields: [repairId], references: [id])
}

model Payment {
  id            String        @id @default(uuid())
  repairId      String
  amount        Float
  paymentType   PaymentType
  paymentMethod PaymentMethod
  receivedBy    String?
  createdAt     DateTime      @default(now())
  repairTicket  RepairTicket  @relation(fields: [repairId], references: [id])
}

model Reminder {
  id             String           @id @default(uuid())
  title          String
  category       ReminderCategory
  amount         Float?
  dueDate        DateTime
  recurrenceDays Int?
  isPaid         Boolean          @default(false)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  createdBy      String?
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
}

model BusinessInfo {
  id      String  @id @default(uuid())
  name    String
  address String?
  phone   String?
}

// Shop expenses unrelated to customer repair payments (coffee, rent,
// transport, buying old devices to harvest parts from, etc). Kept
// separate from Payment so repair revenue and shop spending never mix
// in a single total by accident.
//
// USED_DEVICE_PURCHASE is intentionally just a normal expense category
// with a free-text description (e.g. "Old Samsung TV, for parts") — no
// extra relations added here. A future inventory feature can link a
// SparePart back to the Expense it was harvested from (e.g. an optional
// sourceExpenseId on SparePart) without requiring any change to this
// model, keeping today's schema change minimal.
model Expense {
  id           String          @id @default(uuid())
  category     ExpenseCategory
  description  String
  amount       Float
  date         DateTime        @default(now())
  recordedById String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
}

enum Role {
  ADMINISTRATOR
  MANAGER
  CASHIER
  TECHNICIAN
}

enum RepairStatus {
  RECEIVED
  DIAGNOSING
  WAITING_FOR_PARTS
  REPAIRING
  COMPLETED
  DELIVERED
}

enum DeviceType {
  PHONE
  TABLET
  LAPTOP
  DESKTOP
  TV
  RECEIVER
  AMPLIFIER
  MOSQUE_MICROPHONE
   SPEAKER
  OTHER
}

enum RepairVisibility {
 NORMAL
 PRIVATE
}

enum ExpenseCategory {
  TEA_COFFEE
  FOOD
  TRANSPORT
  UTILITIES
  USED_DEVICE_PURCHASE
  PARTS_PURCHASE
  OTHER
}

enum MediaType {
  IMAGE
  VIDEO
}

enum PaymentType {
  DEPOSIT
  PARTIAL
  FINAL
}

enum PaymentMethod {
  CASH
  TELEBIRR
  BANK_TRANSFER
}

enum ReminderCategory {
  SALARY
  RENT
  EKUB
  OTHER
}

enum NotificationType {
  REPAIR_COMPLETED
  NEW_CUSTOMER
  PAYMENT_RECEIVED
}